{
  "name": "gameprobe",
  "version": "0.1.0",
  "description": "Let your coding agent actually play the game it just wrote. MCP server: virtual time, state watching, per-frame controllers for web games, a Unity plugin, and a screen-based fallback for any Windows game.",
  "main": "src/session.js",
  "scripts": {
    "test": "node test/control.mjs && node test/control-reset.mjs && node test/sweep.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "game",
    "gamedev",
    "testing",
    "playtest",
    "qa",
    "ai-agent",
    "claude",
    "unity",
    "webgl",
    "threejs",
    "phaser",
    "playwright"
  ],
  "author": "ahnminjae08043-glitch",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "gameprobe": "src/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "native/",
    "examples/",
    "unity/com.gameprobe.unity/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahnminjae08043-glitch/gameprobe.git"
  },
  "homepage": "https://github.com/ahnminjae08043-glitch/gameprobe#readme",
  "bugs": {
    "url": "https://github.com/ahnminjae08043-glitch/gameprobe/issues"
  }
}
